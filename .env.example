# Optional hosted PostgreSQL. Leave blank for persistent local PGlite.
DATABASE_URL=
# Optional local data directory override.
ESCROWPAL_DATA_DIR=

# PayPal SANDBOX app only. Keep these private; do not use production credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional actual model. With no configuration, the UI identifies the rules fallback.
# For Ollama: provider=ollama, base=http://127.0.0.1:11434, model=an installed model.
# For a compatible remote API: provider=openai-compatible, base=API's /v1 URL.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional local Laya companion service. Run it separately; weights are not bundled.
LAYA_BASE_URL=
LAYA_API_KEY=
